# DeepSeek / LLM (optional — without a key, Sesame falls back to heuristic analysis)
SESAME_DEEPSEEK_API_KEY=
SESAME_DEEPSEEK_API_BASE=
SESAME_DEEPSEEK_MODEL=deepseek-v4-pro
SESAME_DEEPSEEK_TEMPERATURE=0.0
SESAME_DEEPSEEK_THINKING=true

# General runtime
SESAME_HTTP_TIMEOUT=8.0
SESAME_MAX_CONTEXT_CHARS=8000
SESAME_MAX_TARGETS=128
SESAME_DEBUG=false
